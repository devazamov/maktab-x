# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_WEBHOOK_SECRET=       # random string, also passed to setWebhook

# --- App ---
NEXT_PUBLIC_APP_URL=           # e.g. https://maktabx.vercel.app (the deployed Mini App URL)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server-only, never expose to the client

# --- Auth ---
AUTH_SECRET=                   # random 32+ char string, signs session cookies
ADMIN_TELEGRAM_IDS=            # comma-separated Telegram numeric IDs, get SUPER_ADMIN on first login only

# --- AI (wired up in Phase 3, declared now per section 40) ---
GEMINI_API_KEY=
